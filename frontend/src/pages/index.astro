---
import Base from '../layouts/Base.astro';
import HeroCarousel from '../components/HeroCarousel.svelte';
---
<Base title="Faizen Studio — Use what exists, build what’s next.">
  <section class="marquee wrap" aria-labelledby="hero-h">
    <p class="eyebrow">Faizen Studio · Digital solutions, partnership-first</p>
    <h1 id="hero-h">Use what exists.<br />Build what’s next.</h1>
    <p class="lede">We help you discover solutions already built by Faizen — or bring your problem and build a new one together.</p>
    <div class="hero-cta">
      <a class="cta" href="/lets-build-together">Let’s build together <span aria-hidden="true">→</span></a>
      <a class="ghost" href="/build">Explore builds</a>
    </div>
    <ol class="intent">
      <li><strong>Can I get this?</strong><span>Products / existing solutions.</span></li>
      <li><strong>Can you build this with me?</strong><span>Custom solutions, together.</span></li>
    </ol>
  </section>

  <section class="proof wrap" aria-label="Featured work">
    <div class="sec-head">
      <h2>Featured proof</h2>
      <a href="/build">All builds →</a>
    </div>
    <HeroCarousel client:load />
  </section>

  <section class="builds wrap" aria-labelledby="wwb-h">
    <div class="sec-head">
      <h2 id="wwb-h">What we build</h2>
      <p>Proof first. Every entry shows context, solution, features, and result — technology never leads the narrative.</p>
    </div>
    <div class="cards">
      <article>
        <p class="mono">01 · Proof</p>
        <h3>Builds</h3>
        <p>Completed work with screenshots, key features, and measured impact.</p>
        <a href="/build">Browse builds →</a>
      </article>
      <article>
        <p class="mono">02 · Products</p>
        <h3>Solutions</h3>
        <p>Usable products with pricing, FAQ, and a Get Started path.</p>
        <a href="/solutions">Browse solutions →</a>
      </article>
      <article>
        <p class="mono">03 · Capability</p>
        <h3>Services</h3>
        <p>Custom software, system development, API integration, maintenance.</p>
        <a href="/with-us">How we work →</a>
      </article>
    </div>
  </section>

  <section class="steps wrap" aria-labelledby="how-h">
    <div class="sec-head">
      <h2 id="how-h">How we work together</h2>
    </div>
    <ol>
      <li><strong>Share intent + brief</strong><span>Existing, custom, partnership, or other — one low-friction form.</span></li>
      <li><strong>Explore existing vs custom</strong><span>If a solution fits, start now. If not, scope it together.</span></li>
      <li><strong>Build iteratively</strong><span>HTML-first, demonstrable progress, no jargon-led updates.</span></li>
      <li><strong>Launch + maintain</strong><span>Docs, CMS, and a maintenance path from day one.</span></li>
    </ol>
  </section>

  <section class="final wrap" aria-labelledby="cta-h">
    <h2 id="cta-h">Have a problem or an idea?</h2>
    <p>Tell us your intent, your contact, and a short brief. One endpoint, no extra fields.</p>
    <a class="cta big" href="/lets-build-together">Get started <span aria-hidden="true">→</span></a>
  </section>
</Base>
<style>
  .marquee { padding: 3rem 1.25rem 1.5rem; border-bottom: 1px solid var(--color-line); }
  .eyebrow { font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-mute); }
  .marquee h1 { font-size: clamp(2.6rem, 6vw, 4.5rem); letter-spacing: -0.02em; }
  .lede { font-size: 1.15rem; color: var(--color-ink-2); max-width: 56ch; }
  .hero-cta { display: flex; gap: 0.8rem; align-items: center; flex-wrap: wrap; margin: 1.2rem 0; }
  .ghost { font-weight: 700; color: var(--color-ink); text-decoration: underline; text-underline-offset: 4px; white-space: nowrap; }
  .intent { list-style: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.8rem; padding: 0; margin: 1.5rem 0 0; }
  .intent li { border: 1px solid var(--color-line); border-left: 4px solid var(--color-accent); padding: 0.8rem 1rem; background: #fff; }
  .intent strong { display: block; font-family: var(--font-display); }
  .intent span { color: var(--color-mute); font-size: 0.92rem; }
  .proof, .builds, .steps, .final { padding-top: 2.2rem; }
  .sec-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; border-bottom: 2px solid var(--color-ink); padding-bottom: 0.6rem; margin-bottom: 1.2rem; flex-wrap: wrap; }
  .sec-head h2 { font-size: clamp(1.5rem, 3vw, 2.1rem); margin: 0; }
  .sec-head p { color: var(--color-mute); max-width: 52ch; margin: 0; }
  .sec-head a { font-weight: 700; white-space: nowrap; }
  .cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .cards article { border: 1px solid var(--color-line); background: #fff; padding: 1.2rem; display: flex; flex-direction: column; gap: 0.4rem; }
  .cards article h3 { font-size: 1.3rem; margin: 0; }
  .cards article p { color: var(--color-ink-2); margin: 0 0 0.5rem; }
  .cards a { font-weight: 700; margin-top: auto; }
  .mono { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.1em; color: var(--color-mute); text-transform: uppercase; }
  .steps ol { list-style: none; counter-reset: s; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; padding: 0; margin: 0; }
  .steps li { counter-increment: s; border-top: 3px solid var(--color-ink); padding-top: 0.7rem; }
  .steps li::before { content: "0" counter(s); font-family: var(--font-mono); color: var(--color-accent-ink); font-weight: 500; }
  .steps strong { display: block; font-family: var(--font-display); margin: 0.3rem 0; }
  .steps span { color: var(--color-mute); font-size: 0.92rem; }
  .final { background: var(--color-ink); color: #fff; border-radius: 12px; padding: 2.2rem; margin-top: 2.5rem; }
  .final h2 { font-size: clamp(1.7rem, 3.4vw, 2.4rem); }
  .final p { color: #d4d4d8; max-width: 52ch; }
  .final .cta.big { font-size: 1.05rem; padding: 0.8rem 1.4rem; }
  @media (max-width: 768px) {
    .intent, .cards, .steps ol { grid-template-columns: minmax(0, 1fr); }
    .marquee { padding-top: 2rem; }
  }
</style>
