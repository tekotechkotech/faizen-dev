---
import Base from '../layouts/Base.astro';
import HeroCarousel from '../components/HeroCarousel.svelte';
import InquiryForm from '../components/InquiryForm.svelte';
import { api } from '../lib/api';
const heros = await api.heros();
const builds = (await api.builds()).slice(0, 3);
const solutions = (await api.solutions()).slice(0, 3);
---
<Base title="Faizen Studio — Digital Solutions">
  <section>
    <p class="kicker">BUILD · SOLUTIONS · WITH US</p>
    <h1>Kami membangun solusi digital yang bisa langsung dipakai.</h1>
    <p>Jelajahi produk Faizen atau bangun solusi baru bersama kami.</p>
    <p><a class="cta" href="/lets-build-together">Let’s build together →</a></p>
    <HeroCarousel slides={heros} client:load />
  </section>

  <section>
    <h2>What We Build</h2>
    <div class="cards">
      {builds.map((b) => (
        <article class="card"><span class="tag">BUILD / CLIENT PROJECT</span><h3><a href={`/build/${b.slug}`}>{b.title}</a></h3><p>{b.short_description}</p></article>
      ))}
      {solutions.map((s) => (
        <article class="card"><span class="tag">SOLUTION / FAIZEN PRODUCT</span><h3><a href={`/solutions/${s.slug}`}>{s.name}</a></h3><p>{s.short_description}</p></article>
      ))}
    </div>
  </section>

  <section>
    <h2>Let’s build together.</h2>
    <p>Punya masalah atau ide? Ceritakan, kita wujudkan bersama.</p>
    <p><a class="cta" href="/lets-build-together">Mulai →</a></p>
  </section>
</Base>
