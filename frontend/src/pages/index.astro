---
import Base from '../layouts/Base.astro';
import HeroCarousel from '../components/HeroCarousel.svelte';
import { api } from '../lib/api';
const [heros, builds, solutions, services, articles] = await Promise.all([
  api.heros(), api.builds(), api.solutions(), api.services(), api.articles(),
]);
const photos = [
  { id: 'photo-1498050108023-c5249f4df085', alt: 'Kode di layar laptop' },
  { id: 'photo-1460925895917-afdab827c52f', alt: 'Dasbor analitik di laptop' },
  { id: 'photo-1461749280684-dccba630e2f6', alt: 'Layar kode dalam ruang gelap' },
  { id: 'photo-1551434678-e076c223a692', alt: 'Developer bekerja bersama' },
  { id: 'photo-1522071820081-009f0129c71c', alt: 'Tim berkolaborasi mengelilingi meja' },
];
const u = (id: string, w: number) => `https://images.unsplash.com/${id}?q=80&w=${w}&auto=format&fit=crop`;
const heroSlides = heros.map((h, i) => ({
  type: h.type,
  title: h.title_override ?? (h.type === 'CUSTOM' ? 'Mari bangun bersama' : 'Karya Faizen'),
  desc: h.description_override ?? '',
  href: h.type === 'BUILD' ? '/build' : h.type === 'SOLUTION' ? '/solutions' : '/lets-build-together',
  img: u(photos[(i + 1) % photos.length].id, 800),
  alt: photos[(i + 1) % photos.length].alt,
}));
const featured = [...builds.slice(0, 3).map((b) => ({ kind: 'BUILD', title: b.title, desc: b.short_description, href: `/build/${b.slug}` })),
  ...solutions.slice(0, 3).map((s) => ({ kind: 'SOLUTION', title: s.name, desc: s.short_description, href: `/solutions/${s.slug}` }))];
---
<Base title="Faizen Studio — Digital Solutions" path="/">
  <div class="marquee">
    <div class="wrap hero-grid">
      <div>
        <p class="kicker">Software House & Custom Web Studio</p>
        <h1>Ubah ide bisnis Anda menjadi <span class="accent">website & aplikasi</span> modern berkinerja tinggi.</h1>
        <p class="lede">Kami membangun solusi digital yang cepat, aman, dan mudah dikelola. Dari website company profile, sistem web, hingga aplikasi SaaS yang siap tumbuh bersama bisnis Anda.</p>
        <p><a class="cta" data-track="get_started" href="/lets-build-together">Let’s build together →</a></p>
        <div class="paths">
          <a class="path" href="/solutions"><span class="path-num">01</span><span class="path-title">Pakai solusi yang sudah ada</span><span class="path-arrow">→</span></a>
          <a class="path" href="/lets-build-together"><span class="path-num">02</span><span class="path-title">Bangun baru bersama kami</span><span class="path-arrow">→</span></a>
        </div>
      </div>
      <div>
        <HeroCarousel slides={heroSlides} client:load />
      </div>
    </div>
  </div>
    </div>
  </div>

  <div class="wrap proof" aria-label="Bukti karya">
    <div><strong>{builds.length}</strong><span>BUILD TERBIT</span></div>
    <div><strong>{solutions.length}</strong><span>SOLUSI</span></div>
    <div><strong>{services.length}</strong><span>LAYANAN</span></div>
    <div><strong>{articles.length}</strong><span>ARTIKEL</span></div>
  </div>

  <div class="wrap prooffig">
    <img src={u('photo-1522071820081-009f0129c71c', 1600)} width="1600" height="900" alt="Tim Faizen berkolaborasi" loading="lazy" decoding="async" />
  </div>

  <section class="block">
    <div class="wrap">
      <div class="sec-head"><h2>What We Build</h2><a href="/build">Semua build →</a></div>
      <div class="rows">
        {featured.map((f, i) => (
          <div class="row"><span class="idx">{String(i + 1).padStart(2, '0')}</span><div><img class="rowthumb" src={u(photos[i % photos.length].id, 640)} width="640" height="400" alt={photos[i % photos.length].alt} loading="lazy" decoding="async" /><span class="tag">{f.kind}</span><h3><a href={f.href}>{f.title}</a></h3><p>{f.desc}</p></div></div>
        ))}
      </div>
    </div>
  </section>

  <div class="cta-band">
    <div class="wrap" style="padding-top:3.5rem;padding-bottom:3.5rem">
      <h2>Let’s build together.</h2>
      <p style="max-width:44ch">Punya masalah atau ide? Satu formulir, tiga kolom, langsung sampai ke kami.</p>
      <p><a class="cta" data-track="get_started" href="/lets-build-together">Mulai →</a></p>
    </div>
  </div>
</Base>
