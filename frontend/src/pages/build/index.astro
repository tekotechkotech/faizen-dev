---
import Base from '../../layouts/Base.astro';
import { api } from '../../lib/api';
const builds = await api.builds();
---
<Base title="Build — Faizen Studio">
  <p class="kicker">BUILD · Bukti karya</p>
  <h1>Build</h1>
  <p>Apa yang sudah Faizen bangun: proyek klien, proyek internal, dan eksperimen.</p>
  {builds.length === 0 ? (
    <div class="empty"><p>Belum ada build yang dipublikasikan. <a href="/lets-build-together">Mari bangun bersama →</a></p></div>
  ) : (
    <>
    <p class="carhead"><span></span><span class="carbtns"><button class="carbtn" type="button" data-carbtn="car-build" data-dir="prev" aria-label="Geser kiri"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg></button><button class="carbtn" type="button" data-carbtn="car-build" data-dir="next" aria-label="Geser kanan"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></button></span></p>
    <div class="cards swipe" id="car-build" tabindex="0" role="region" aria-label="Daftar build, geser untuk melihat">
      {builds.map((b) => (
        <article class="card">
          <span class="tag">BUILD / CLIENT PROJECT</span>
          <h3><a href={`/build/${b.slug}`}>{b.title}</a></h3>
          <p>{b.short_description}</p>
        </article>
      ))}
    </div>
    </>
  )}
</Base>
