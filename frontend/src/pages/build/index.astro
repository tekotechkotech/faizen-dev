---
import Base from '../../layouts/Base.astro';
export const prerender = true;
const api = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8000/api';
let builds = [];
try { const r = await fetch(`${api}/builds`); if (r.ok) builds = (await r.json()).data ?? []; } catch {}
---
<Base title="Build — Faizen Studio"><h1>Build — proof</h1><ul>{builds.map(b => <li><a href={`/build/${b.slug}`}>{b.title}</a></li>)}</ul></Base>
