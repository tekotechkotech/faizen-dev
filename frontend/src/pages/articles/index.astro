---
import Base from '../../layouts/Base.astro';
import { api } from '../../lib/api';
const articles = await api.articles();
const cats = ['Technical', 'Business', 'Product', 'Insight'];
---
<Base title="Articles — Faizen Studio">
  <p class="kicker">ARTICLES · Pengetahuan & penemuan</p>
  <h1>Articles</h1>
  <p>Kategori: {cats.join(' · ')}</p>
  {articles.length === 0 ? (
    <div class="empty"><p>Belum ada artikel. <a href="/solutions">Lihat solusi →</a></p></div>
  ) : (
    <>
    <p class="carhead"><span></span><span class="carbtns"><button class="carbtn" type="button" data-carbtn="car-articles" data-dir="prev" aria-label="Geser kiri"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg></button><button class="carbtn" type="button" data-carbtn="car-articles" data-dir="next" aria-label="Geser kanan"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></button></span></p>
    <div class="cards swipe" id="car-articles" tabindex="0" role="region" aria-label="Daftar artikel, geser untuk melihat">
      {articles.map((a) => (
        <article class="card">
          <span class="tag">{a.category}</span>
          <h3><a href={`/articles/${a.slug}`}>{a.title}</a></h3>
          <p>{a.excerpt}</p>
        </article>
      ))}
    </div>
    </>
  )}
</Base>
