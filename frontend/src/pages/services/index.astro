---
import Base from '../../layouts/Base.astro';
import { api } from '../../lib/api';
const services = await api.services();
---
<Base title="Services — Faizen Studio">
  <p class="kicker">SERVICES · Yang bisa kita bangun bersama</p>
  <h1>Services</h1>
  {services.length === 0 ? (
    <div class="empty"><p>Belum ada layanan. <a href="/lets-build-together">Diskusi kebutuhan →</a></p></div>
  ) : (
    <>
    <p class="carhead"><span></span><span class="carbtns"><button class="carbtn" type="button" data-carbtn="car-services" data-dir="prev" aria-label="Geser kiri">←</button><button class="carbtn" type="button" data-carbtn="car-services" data-dir="next" aria-label="Geser kanan">→</button></span></p>
    <div class="cards swipe" id="car-services" tabindex="0" role="region" aria-label="Daftar layanan, geser untuk melihat">
      {services.map((s) => (
        <article class="card">
          <span class="tag">SERVICE</span>
          <h3><a href={`/services/${s.slug}`}>{s.title}</a></h3>
          <p>{s.short_description}</p>
        </article>
      ))}
    </div>
    </>
  )}
</Base>
