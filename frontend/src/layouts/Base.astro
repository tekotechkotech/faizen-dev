---
import { api } from '../lib/api';
const { title = 'Faizen Studio — Digital Solutions', description = 'Faizen Studio — Digital Solutions. Temukan solusi yang sudah ada, atau bangun solusi baru bersama kami.', path = '/' } = Astro.props;
const canonical = `https://dev.faizen.biz.id${path}`;
const company = await api.company();
const brand = company?.company_name ?? 'Faizen Studio';
const email = company?.email ?? 'info@faizenstudio.com';
const wa = company?.phone_whatsapp ?? '';
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <style>
      :root { color-scheme: light; }
      body { font-family: system-ui, -apple-system, 'Segoe UI', sans-serif; margin: 0; color: #18181b; background: #fff; line-height: 1.6; }
      header nav, main, footer > div { max-width: 64rem; margin: 0 auto; padding: 1rem; }
      header { border-bottom: 1px solid #e4e4e7; }
      header nav { display: flex; gap: 1rem; align-items: center; flex-wrap: wrap; }
      header nav a { color: #18181b; text-decoration: none; }
      header nav a:focus-visible, a:focus-visible, button:focus-visible { outline: 2px solid #059669; outline-offset: 2px; }
      .brand { font-weight: 700; letter-spacing: .05em; }
      .cta { display: inline-block; background: #059669; color: #fff; padding: .6rem 1.2rem; border-radius: .375rem; text-decoration: none; font-weight: 600; }
      .cta:hover { background: #047857; }
      .kicker { letter-spacing: .1em; font-size: .8rem; color: #52525b; }
      .cards { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr)); }
      .card { border: 1px solid #e4e4e7; border-radius: .5rem; padding: 1rem; }
      .card h3 { margin: 0 0 .5rem; }
      .tag { font-size: .75rem; background: #f4f4f5; border-radius: .25rem; padding: .1rem .4rem; color: #52525b; }
      footer { border-top: 1px solid #e4e4e7; margin-top: 3rem; background: #fafafa; }
      footer nav { display: flex; gap: 2rem; flex-wrap: wrap; }
      footer ul { list-style: none; padding: 0; margin: .25rem 0; }
      form label { display: block; margin: .75rem 0 .25rem; font-weight: 600; }
      form input, form select, form textarea { width: 100%; max-width: 28rem; padding: .5rem; border: 1px solid #d4d4d8; border-radius: .375rem; }
      .error { color: #b91c1c; }
      .empty { border: 1px dashed #d4d4d8; border-radius: .5rem; padding: 1.5rem; color: #52525b; }
      .skip { position: absolute; left: -999px; top: 0; background: #059669; color: #fff; padding: .5rem 1rem; z-index: 100; }
      .skip:focus { left: 0; }
      @media (prefers-reduced-motion: reduce) { * { animation: none !important; transition: none !important; } }
    </style>
  </head>
  <body>
    <a class="skip" href="#main">Lewati ke konten</a>
    <header>
      <nav aria-label="Utama">
        <span class="brand">BUILD · SOLUTIONS · WITH US</span>
        <a href="/build">Build</a>
        <a href="/solutions">Solutions</a>
        <a href="/with-us">With Us</a>
        <a class="cta" data-track="click_cta" href="/lets-build-together">Let’s build together →</a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <script>
      import { track } from '../lib/analytics';
      document.addEventListener('click', (e) => {
        const t = (e.target as HTMLElement).closest('[data-track]') as HTMLElement | null;
        if (t && t.dataset.track) track(t.dataset.track as any, { path: location.pathname });
      });
    </script>
    <footer>
      <div>
        <nav aria-label="Footer">
          <div><strong>Explore</strong><ul><li><a href="/build">Build</a></li><li><a href="/solutions">Solutions</a></li><li><a href="/articles">Articles</a></li><li><a href="/with-us">With Us</a></li></ul></div>
          <div><strong>Build With Us</strong><ul><li><a href="/services">Services</a></li><li><a href="/lets-build-together">Let’s build together</a></li></ul></div>
          <div><strong>Connect</strong><ul><li><a href={`mailto:${email}`}>{email}</a></li>{wa && <li><a href={`https://wa.me/${wa.replace(/[^0-9]/g, '')}`}>WhatsApp</a></li>}</ul></div>
          <div><strong>Legal</strong><ul><li><a href="/privacy">Privacy</a></li><li><a href="/terms">Terms</a></li></ul></div>
        </nav>
        <p>{brand} — Let’s build together.</p>
      </div>
    </footer>
  </body>
</html>
