---
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/plus-jakarta-sans/400.css';
import '@fontsource/plus-jakarta-sans/500.css';
import '@fontsource/plus-jakarta-sans/600.css';
import { api } from '../lib/api';
const { title = 'Faizen Studio — Digital Solutions', description = 'Faizen Studio — Digital Solutions. Temukan solusi yang sudah ada, atau bangun solusi baru bersama kami.', path = '/' } = Astro.props;
const canonical = `https://dev.faizen.biz.id${path}`;
const company = await api.company();
const brand = company?.company_name ?? 'Faizen Studio';
const email = company?.email ?? 'info@faizenstudio.com';
const wa = company?.phone_whatsapp ?? '';
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script is:inline>
      try { document.documentElement.dataset.theme = localStorage.getItem('faizen-theme') || 'light'; } catch {}
    </script>
    <style>
      /* Hallmark · macrostructure: Marquee Hero · nav: statement-bar · footer: index · genre: editorial
       * pre-emit critique: P5 H5 E4 S5 R5 V4 */
      :root {
        --color-paper: #fafaf9;
        --color-paper-2: #f5f5f4;
        --color-ink: #1c1917;
        --color-muted: #57534e;
        --color-line: #e7e5e4;
        --color-accent: #047857;
        --color-accent-bg: #059669;
        --color-accent-ink: #ecfdf5;
        --font-display: 'Space Grotesk', system-ui, sans-serif;
        --font-body: 'Plus Jakarta Sans', system-ui, sans-serif;
        --font-mono: ui-monospace, 'Roboto Mono', monospace;
      }
      [data-theme="dark"] {
        --color-paper: #09090b;
        --color-paper-2: #131316;
        --color-ink: #fafafa;
        --color-muted: #a1a1aa;
        --color-line: #27272a;
        --color-accent: #34d399;
        --color-accent-bg: #059669;
        --color-accent-ink: #022c22;
      }
      html, body { overflow-x: clip; }
      body { font-family: var(--font-body); margin: 0; color: var(--color-ink); background: var(--color-paper); line-height: 1.6; font-size: 1rem; }
      h1, h2, h3 { font-family: var(--font-display); font-style: normal; line-height: 1.05; letter-spacing: -0.01em; overflow-wrap: anywhere; min-width: 0; }
      .wrap { max-width: 72rem; margin: 0 auto; padding: 0 1.25rem; }
      /* Nav: statement bar */
      .topbar { border-bottom: 1px solid var(--color-ink); background: var(--color-paper); }
      .topbar .wrap { display: flex; gap: 1.25rem; align-items: baseline; flex-wrap: wrap; padding-top: .9rem; padding-bottom: .9rem; }
      .wordmark { font-family: var(--font-display); font-weight: 700; font-size: 1.1rem; letter-spacing: .02em; }
      .navphrase { font-family: var(--font-mono); font-size: .72rem; letter-spacing: .14em; color: var(--color-muted); }
      .topbar nav { display: flex; gap: 1.1rem; margin-left: auto; align-items: center; flex-wrap: wrap; }
      .topbar nav a { color: var(--color-ink); text-decoration: none; font-weight: 500; font-size: .95rem; }
      .topbar nav a:hover { color: var(--color-accent); }
      a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
      /* Marquee hero */
      .marquee { border-bottom: 1px solid var(--color-ink); padding: clamp(3rem, 8vw, 6rem) 0 clamp(2rem, 5vw, 3.5rem); }
      .marquee h1 { font-size: clamp(2.6rem, 8vw, 5.5rem); margin: 0 0 1rem; max-width: 16ch; }
      .marquee h1 .accent { color: var(--color-accent); }
      .marquee .lede { font-size: 1.15rem; color: var(--color-muted); max-width: 44ch; margin: 0 0 2rem; }
      .paths { display: grid; grid-template-columns: 1fr; gap: 0; border-top: 1px solid var(--color-ink); margin-top: 2.5rem; }
      .path { display: flex; gap: 1rem; align-items: baseline; padding: 1.1rem 0; border-bottom: 1px solid var(--color-line); text-decoration: none; color: var(--color-ink); }
      .path:hover .path-title { color: var(--color-accent); }
      .path-num { font-family: var(--font-mono); font-size: .8rem; color: var(--color-muted); }
      .path-title { font-family: var(--font-display); font-weight: 700; font-size: clamp(1.3rem, 3vw, 1.9rem); }
      .path-arrow { margin-left: auto; font-family: var(--font-display); }
      /* Proof strip: honest counts */
      .proof { display: flex; gap: 2rem; flex-wrap: wrap; padding: 1.25rem 0; border-bottom: 1px solid var(--color-ink); }
      .proof div strong { font-family: var(--font-display); font-size: 1.6rem; display: block; }
      .proof div span { font-size: .8rem; color: var(--color-muted); letter-spacing: .06em; }
      /* Sections */
      section.block { padding: clamp(2.5rem, 6vw, 4.5rem) 0; }
      .sec-head { display: flex; align-items: baseline; gap: 1rem; border-bottom: 1px solid var(--color-ink); padding-bottom: .75rem; margin-bottom: 1.5rem; }
      .sec-head h2 { font-size: clamp(1.6rem, 4vw, 2.4rem); margin: 0; }
      .sec-head a { margin-left: auto; font-size: .9rem; color: var(--color-accent); font-weight: 600; }
      .rows .row { display: grid; grid-template-columns: 3rem 1fr; gap: 1rem; padding: 1.1rem 0; border-bottom: 1px solid var(--color-line); align-items: baseline; }
      .rows .row .idx { font-family: var(--font-mono); color: var(--color-muted); font-size: .85rem; }
      .rows .row h3 { margin: 0 0 .3rem; font-size: 1.25rem; }
      .rows .row h3 a { color: var(--color-ink); text-decoration: none; }
      .rows .row h3 a:hover { color: var(--color-accent); }
      .rows .row p { margin: 0; color: var(--color-muted); }
      .tag { font-family: var(--font-mono); font-size: .7rem; letter-spacing: .08em; color: var(--color-accent); text-transform: uppercase; }
      .cards { display: grid; gap: 0; border-top: 1px solid var(--color-ink); }
      .card { padding: 1.1rem 0; border-bottom: 1px solid var(--color-line); }
      .card h3 { margin: 0 0 .3rem; font-size: 1.2rem; }
      .card h3 a { color: var(--color-ink); text-decoration: none; }
      .card h3 a:hover { color: var(--color-accent); }
      .card p { margin: 0; color: var(--color-muted); }
      .cta { display: inline-block; background: var(--color-ink); color: var(--color-paper); padding: .7rem 1.4rem; text-decoration: none; font-weight: 600; border-radius: 2px; }
      .cta:hover { background: var(--color-accent); color: #fff; }
      .cta-band { background: var(--color-ink); color: var(--color-paper); }
      .cta-band h2 { font-size: clamp(2rem, 6vw, 3.5rem); margin: 0 0 1rem; }
      .cta-band .cta { background: var(--color-accent-bg); }
      .cta-band .cta:hover { background: #047857; }
      /* Carousel / spotlight */
      .spot { background: var(--color-paper-2); border-top: 1px solid var(--color-ink); border-bottom: 1px solid var(--color-ink); }
      .spot-title { font-family: var(--font-display); font-size: clamp(1.8rem, 5vw, 3rem); margin: 0 0 .5rem; }
      .spot-nav button { font-family: var(--font-display); background: none; border: 1px solid var(--color-ink); border-radius: 2px; padding: .35rem .8rem; cursor: pointer; color: var(--color-ink); }
      .spot-nav button:hover { background: var(--color-ink); color: var(--color-paper); }
      /* Footer index */
      footer { border-top: 1px solid var(--color-ink); margin-top: 0; background: var(--color-paper); }
      footer .cols { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; padding: 2rem 0; }
      footer ul { list-style: none; padding: 0; margin: .4rem 0; }
      footer li { margin: .3rem 0; }
      footer a { color: var(--color-ink); text-decoration: none; }
      footer a:hover { color: var(--color-accent); }
      footer .fine { border-top: 1px solid var(--color-line); padding: 1rem 0 2rem; color: var(--color-muted); font-size: .85rem; display: flex; gap: 1rem; flex-wrap: wrap; }
      form label { display: block; margin: .9rem 0 .3rem; font-weight: 600; }
      form input, form select, form textarea { width: 100%; max-width: 30rem; padding: .6rem; border: 1px solid var(--color-ink); border-radius: 2px; background: var(--color-paper); color: var(--color-ink); font: inherit; }
      img { max-width: 100%; height: auto; }
      .rowthumb, .cardthumb, .prooffig img { border: 1px solid var(--color-line); border-radius: 2px; display: block; }
      .themebtn { font: inherit; background: none; border: 1px solid var(--color-ink); border-radius: 2px; padding: .35rem .7rem; cursor: pointer; color: var(--color-ink); }
      .error { color: #b91c1c; }
      .empty { border: 1px dashed var(--color-muted); padding: 1.5rem; color: var(--color-muted); }
      .kicker { font-family: var(--font-mono); letter-spacing: .12em; font-size: .75rem; color: var(--color-muted); text-transform: uppercase; }
      .skip { position: absolute; left: -999px; top: 0; background: var(--color-accent); color: #fff; padding: .5rem 1rem; z-index: 100; }
      .skip:focus { left: 0; }
      @media (prefers-reduced-motion: reduce) { * { animation: none !important; transition: none !important; } }
      @media (min-width: 48rem) {
        .paths { grid-template-columns: 1fr 1fr; }
        .path + .path { border-left: 1px solid var(--color-line); padding-left: 2rem; }
        footer .cols { grid-template-columns: 2fr 1fr 1fr 1fr; }
      }
    </style>
  </head>
  <body>
    <a class="skip" href="#main">Lewati ke konten</a>
    <header class="topbar">
      <div class="wrap">
        <span class="wordmark">FAIZEN</span>
        <span class="navphrase">BUILD · SOLUTIONS · WITH US</span>
        <nav aria-label="Utama">
          <a href="/build">Build</a>
          <a href="/solutions">Solutions</a>
          <a href="/with-us">With Us</a>
          <button class="themebtn" id="themebtn" type="button" aria-label="Ganti mode gelap terang">🌙</button>
          <a class="cta" data-track="click_cta" href="/lets-build-together" style="padding:.45rem 1rem;font-size:.9rem">Let’s build together →</a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <script>
      import { track } from '../lib/analytics';
      document.addEventListener('click', (e) => {
        const t = (e.target as HTMLElement).closest('[data-track]') as HTMLElement | null;
        if (t && t.dataset.track) track(t.dataset.track as any, { path: location.pathname });
      });
      const btn = document.getElementById('themebtn');
      const paint = () => { if (btn) btn.textContent = document.documentElement.dataset.theme === 'dark' ? '🌞' : '🌙'; };
      paint();
      btn?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem('faizen-theme', next); } catch {}
        paint();
      });
    </script>
    <footer>
      <div class="wrap cols">
        <div><span class="wordmark">FAIZEN</span><p style="color:var(--color-muted);max-width:30ch">Digital Solutions. Let’s build together.</p></div>
        <nav aria-label="Jelajah"><strong>Jelajah</strong><ul><li><a href="/build">Build</a></li><li><a href="/solutions">Solutions</a></li><li><a href="/articles">Articles</a></li><li><a href="/with-us">With Us</a></li></ul></nav>
        <nav aria-label="Bangun"><strong>Bangun</strong><ul><li><a href="/services">Services</a></li><li><a href="/lets-build-together">Let’s build together</a></li></ul></nav>
        <div><strong>Connect</strong><ul><li><a href={`mailto:${email}`}>{email}</a></li>{wa && <li><a href={`https://wa.me/${wa.replace(/[^0-9]/g, '')}`}>WhatsApp</a></li>}</ul><ul><li><a href="/privacy">Privacy</a></li><li><a href="/terms">Terms</a></li></ul></div>
      </div>
      <div class="wrap fine"><span>{brand}</span><span>Do more, less explain.</span></div>
    </footer>
  </body>
</html>
